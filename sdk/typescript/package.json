{
  "name": "stigmer",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "TypeScript client for a Stigmer board (alpha, not published).",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/test/*.test.js",
    "example": "tsc && node examples/two-agents.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
