#!/usr/bin/env bash
# Create per-task worktrees; PRs merge on GitHub. See CONTRIBUTING.md.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"
pattern='^(feat|fix|refactor|test|docs|chore|ci)/m[0-9]+-t[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$'

die() { echo "wt: $*" >&2; exit 1; }
slug() { echo "${1//\//-}"; }

cmd="${1:-}"; branch="${2:-}"
base_arg="${3:-}"
[[ -n "$cmd" && -n "$branch" ]] || die "usage: wt new <branch> [base]"
[[ "$branch" =~ $pattern ]] || die "branch '$branch' does not match $pattern"
dir=".worktrees/$(slug "$branch")"

case "$cmd" in
  new)
    # One PR per task: the base defaults to the branch the main checkout is on (usually main).
    base="${base_arg:-$(git branch --show-current)}"
    [[ -z "$(git status --porcelain)" ]] || die "main checkout is dirty"
    git worktree add -b "$branch" "$dir" "$base"
    echo "worktree: $root/$dir (from $base)"
    ;;
  *) die "unknown command '$cmd'" ;;
esac
